<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <meta name="theme-color"
          content="#111111">

    <title>Tiempos Atención CD Galapa</title>

    <link rel="stylesheet"
          href="style.css">

</head>


<body>


    <!-- =====================================================
         CONTENEDOR PRINCIPAL
    ====================================================== -->

    <div class="app">


        <!-- =================================================
             ENCABEZADO
        ================================================== -->

        <header class="header">


            <!-- LOGO -->

            <div class="logo-container">

                <img
                    src="logo-asl.png"
                    alt="ASL"
                    class="logo"
                >

            </div>


            <!-- TITULO -->

            <div class="titulo">

                <h1>
                    TIEMPOS ATENCIÓN
                </h1>

                <h2>
                    CD GALAPA
                </h2>

            </div>


            <!-- IDENTIFICACIÓN -->

            <div class="operacion">

                <div class="operacion-icono">
                    🚛
                </div>

                <div>

                    <strong>
                        ATENCIÓN SIDER
                    </strong>

                    <span>
                        CONTROL DE TIEMPO
                    </span>

                </div>

            </div>


        </header>



        <!-- =================================================
             CONTENIDO PRINCIPAL
        ================================================== -->

        <main class="main">


            <!-- =============================================
                 CRONÓMETRO
            ============================================== -->

            <section class="timer-section">


                <div class="timer-box">


                    <div
                        id="reloj"
                        class="reloj"
                    >
                        60:00
                    </div>


                </div>


            </section>



            <!-- =============================================
                 META
            ============================================== -->

            <section class="meta">


                <div class="meta-icono">

                    🎯

                </div>


                <div class="meta-texto">

                    <span>
                        META DE ATENCIÓN
                    </span>

                    <strong>
                        60 MINUTOS
                    </strong>

                </div>


            </section>



            <!-- =============================================
                 MENSAJE DE ESTADO
            ============================================== -->

            <section
                id="mensaje"
                class="mensaje"
            >

                LISTO PARA INICIAR

            </section>



            <!-- =============================================
                 CONTROLES
            ============================================== -->

            <section class="controles">


                <button
                    id="btnIniciar"
                    class="btn btn-iniciar"
                >

                    <span class="btn-icon">
                        ▶
                    </span>

                    INICIAR

                </button>


                <button
                    id="btnFinalizar"
                    class="btn btn-finalizar"
                    disabled
                >

                    <span class="btn-icon">
                        ■
                    </span>

                    FINALIZAR

                </button>


                <button
                    id="btnReiniciar"
                    class="btn btn-reiniciar"
                >

                    <span class="btn-icon">
                        ↻
                    </span>

                    REINICIAR

                </button>


            </section>



            <!-- =============================================
                 ALERTAS
            ============================================== -->

            <section class="alertas">


                <div
                    id="alerta15"
                    class="alerta"
                >

                    <span class="circulo amarillo"></span>

                    <div>
                        <strong>
                            15 MIN
                        </strong>

                        <small>
                            ALERTA
                        </small>
                    </div>

                </div>



                <div
                    id="alerta10"
                    class="alerta"
                >

                    <span class="circulo naranja"></span>

                    <div>
                        <strong>
                            10 MIN
                        </strong>

                        <small>
                            ALERTA
                        </small>
                    </div>

                </div>



                <div
                    id="alerta5"
                    class="alerta"
                >

                    <span class="circulo rojo"></span>

                    <div>
                        <strong>
                            5 MIN
                        </strong>

                        <small>
                            ALERTA
                        </small>
                    </div>

                </div>



                <div
                    id="alerta1"
                    class="alerta"
                >

                    <span class="circulo rojo"></span>

                    <div>
                        <strong>
                            1 MIN
                        </strong>

                        <small>
                            ALERTA
                        </small>
                    </div>

                </div>


            </section>


        </main>



        <!-- =================================================
             BARRA INFERIOR
        ================================================== -->

        <footer class="footer">


            <div>

                <strong>
                    CD GALAPA
                </strong>

                <span>
                    TIEMPOS DE ATENCIÓN
                </span>

            </div>


            <div class="frase">

                JUNTOS MOVEMOS EL RESULTADO

            </div>


            <button
                id="btnPantalla"
                class="pantalla"
                title="Pantalla completa"
            >

                ⛶

            </button>


        </footer>


    </div>



    <!-- JAVASCRIPT -->

    <script src="script.js"></script>


</body>

</html>
